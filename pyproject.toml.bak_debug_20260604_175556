[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "blackcatt"
version = "1.0.0"
description = ""
license = "Apache-2.0"
dependencies = [
    "flwr[simulation]>=1.15.1",
    "flwr-datasets[vision]>=0.5.0",
    "torch==2.5.1",
    "torchvision==0.20.1",
    "click==8.1.7",

]

[tool.hatch.build.targets.wheel]
packages = ["."]

[tool.flwr.app]
publisher = "erodriguez"

[tool.flwr.app.components]
serverapp = "blackcatt.server_app:app"
clientapp = "blackcatt.client_app:app"

[tool.flwr.app.config]
num-server-rounds = 50
fraction-fit = 1
local-epochs = 1


